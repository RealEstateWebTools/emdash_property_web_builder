diff --git a/src/components/plugin-block-attrs.ts b/src/components/plugin-block-attrs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c654365ff7149ac1859f66aa9b258592b354371f
--- /dev/null
+++ b/src/components/plugin-block-attrs.ts
@@ -0,0 +1,72 @@
+export interface PortableTextPluginBlock {
+	_type: string;
+	_key: string;
+	[key: string]: unknown;
+}
+
+export type PluginBlockIdentityField = "id" | "url" | "";
+
+export interface PluginBlockAttrs extends Record<string, unknown> {
+	blockType: string;
+	blockKey?: string;
+	id?: string;
+	identityField?: PluginBlockIdentityField;
+	data?: Record<string, unknown>;
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+	return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function omitPrivateKeys(value: Record<string, unknown>): Record<string, unknown> {
+	return Object.fromEntries(Object.entries(value).filter(([key]) => !key.startsWith("_")));
+}
+
+/**
+ * PT → PM. Mirrors upstream's identity handling (the identity lives under
+ * whichever of `id` / `url` the block arrived with) and additionally keeps the
+ * block's `_key` in `blockKey` so it survives the round-trip.
+ */
+export function portableTextPluginBlockToAttrs(block: PortableTextPluginBlock): PluginBlockAttrs {
+	const identityField: PluginBlockIdentityField =
+		typeof block.id === "string" ? "id" : typeof block.url === "string" ? "url" : "";
+	const identity = identityField ? block[identityField] : undefined;
+	const { _type, _key, ...rest } = block;
+	if (identityField) delete rest[identityField];
+	return {
+		blockType: typeof _type === "string" && _type ? _type : "embed",
+		blockKey: _key,
+		id: typeof identity === "string" ? identity : "",
+		identityField,
+		data: omitPrivateKeys(rest),
+	};
+}
+
+/**
+ * PM → PT. Restores the original `_key` when present (falling back to a fresh
+ * key) and writes the identity back under the field it arrived with. Attrs
+ * without `identityField` (written before EmDash 1.x) default to `id`.
+ */
+export function pluginBlockAttrsToPortableTextBlock(
+	attrs: Record<string, unknown> | undefined,
+	generateKey: () => string,
+): PortableTextPluginBlock {
+	const input = isPlainObject(attrs) ? attrs : {};
+	const { blockType, blockKey, type, id, identityField, data, ...rest } = input;
+	const resolvedType =
+		typeof blockType === "string" && blockType
+			? blockType
+			: typeof type === "string" && type
+				? type
+				: "embed";
+	const resolvedKey = typeof blockKey === "string" && blockKey ? blockKey : generateKey();
+	const field = identityField === "url" || identityField === "" ? identityField : "id";
+
+	return {
+		...(isPlainObject(data) ? data : {}),
+		...omitPrivateKeys(rest),
+		_type: resolvedType,
+		_key: resolvedKey,
+		...(field ? { [field]: typeof id === "string" ? id : "" } : {}),
+	};
+}
