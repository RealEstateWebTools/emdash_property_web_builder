{
	"name": "@emdash-cms/template-blog-cloudflare",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"seed": "node scripts/seed.mjs",
		"seed:demo": "node scripts/seed.mjs full",
		"seed:minimal": "node scripts/seed.mjs minimal",
		"seed:pre-launch": "node scripts/seed.mjs pre-launch",
		"seed:schema": "node scripts/seed-schema.mjs",
		"import:pwb-listings": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/import-pwb-listings.mjs",
		"reset": "node scripts/reset.mjs",
		"export:d1-sql": "node scripts/export-sqlite-for-d1.mjs",
		"sync:prod-db": "node scripts/push-local-db-to-d1.mjs",
		"reset:admin-access": "node scripts/reset-admin-access.mjs --site-url https://emdash-property-web-builder.etewiah.workers.dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "wrangler deploy",
		"deploy:prod": "astro build && wrangler deploy --config wrangler.prod.jsonc",
		"typecheck": "astro check",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:visual": "playwright test -c playwright.visual.config.ts",
		"test:native": "playwright test -c playwright.native.config.ts",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format": "biome format --write",
		"check": "astro check && vitest run"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.3",
		"@astrojs/react": "^6.0.6",
		"@emdash-cms/cloudflare": "^1.1.0",
		"@emdash-cms/plugin-forms": "^0.2.9",
		"@emdash-cms/plugin-webhook-notifier": "^0.2.2",
		"astro": "^7.3.5",
		"better-sqlite3": "^13.0.3",
		"emdash": "^1.1.0",
		"leaflet": "^1.9.4",
		"pwb-page-parts": "workspace:*",
		"pwb-properties": "workspace:*",
		"pwb-property-embeds": "workspace:*",
		"pwb-valuation": "workspace:*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "^5.20261005.1",
		"@playwright/test": "^1.63.0",
		"@types/better-sqlite3": "^9.6.0",
		"@vitest/coverage-v8": "^4.1.11",
		"happy-dom": "^20.14.5",
		"msw": "^2.15.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.147.0"
	},
	"pnpm": {
		"overrides": {
			"kysely": "0.29.2",
			"yaml": "2.8.4",
			"devalue": "^5.9.3",
			"sanitize-html": "2.17.4",
			"ws": ">=8.20.1",
			"qs": ">=6.15.2",
			"hono": "^4.12.25",
			"fast-uri": "^3.1.7",
			"ip-address": "^10.3.1",
			"smol-toml": "^1.7.1",
			"nanoid": "^3.3.18"
		},
		"onlyBuiltDependencies": [
			"msw",
			"better-sqlite3"
		],
		"patchedDependencies": {
			"emdash@1.1.0": "patches/emdash@1.1.0.patch"
		}
	}
}
